# Discovery-run model provider. One of: gemini | groq
# Only the discovery run uses an LLM; replay never calls a model.
CUA_LLM_PROVIDER=gemini

# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fallback free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Target surface for the mock back-office app
MOCKBANK_HOST=127.0.0.1
MOCKBANK_PORT=5001
